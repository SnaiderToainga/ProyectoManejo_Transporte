# Configuración del Servidor Express
PORT=3000
# En ejecución local usar http://localhost:5173; en Docker Compose usar http://localhost:8088
FRONTEND_URL=http://localhost:5173
# Conexión a Base de Datos (Supabase Transaction Pooler - Puerto 6543)
DATABASE_URL=postgresql://postgres.yeeivqmxivgcwkgdwndc:TU_PASSWORD_AQUI@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Parámetros del Negocio
TIEMPO_RESERVA_MINUTOS=5
# Secretos HMAC locales/servidor (generar cadenas aleatorias >= 32 caracteres en entorno real)
SESSION_SECRET=reemplazar_por_secreto_sesion_admin_32_caracteres
CUSTOMER_SESSION_SECRET=reemplazar_por_secreto_sesion_cliente_32_caracteres
# Pasarela de Pagos Stripe Sandbox (USD) - usar únicamente llaves sk_test_ y whsec_ de pruebas
STRIPE_SECRET_KEY=sk_test_reemplazar_por_llave_sandbox
STRIPE_WEBHOOK_SECRET=whsec_reemplazar_por_secreto_webhook_sandbox
# Notificaciones por correo (opcional: Resend HTTP o SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

